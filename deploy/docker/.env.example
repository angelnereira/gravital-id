# .env.example — Plantilla de variables de entorno para desarrollo local (ADR-0013, REQ-REL-001)
# NUNCA incluyas secretos reales, contraseñas de producción ni claves privadas en este archivo.
# Copia este archivo a deploy/docker/.env para desarrollo local: cp deploy/docker/.env.example deploy/docker/.env

# ------------------------------------------------------------------------------
# Configuración General del Entorno
# ------------------------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=info
RUST_BACKTRACE=1

# ------------------------------------------------------------------------------
# Base de Datos PostgreSQL (pip-indexer)
# ------------------------------------------------------------------------------
POSTGRES_DB=gravital_id_dev
POSTGRES_USER=gravital
POSTGRES_PASSWORD=dev_postgres_password_local_only
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://gravital:dev_postgres_password_local_only@postgres:5432/gravital_id_dev?sslmode=disable

# ------------------------------------------------------------------------------
# Nodo EVM Local (Anvil)
# ------------------------------------------------------------------------------
EVM_RPC_URL=http://anvil:8545
EVM_CHAIN_ID=31337
EVM_FINALITY_CONFIRMATIONS=1
EVM_BLOCK_POLL_INTERVAL_MS=1000

# Direcciones de contratos locales desplegados (deploy/environments/local/contracts.json)
TRUST_REGISTRY_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
STATUS_ANCHOR_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
GOVERNANCE_TIMELOCK_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# ------------------------------------------------------------------------------
# Almacenamiento S3 Compatible Local (MinIO)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_TRUST_BUNDLE_BUCKET=gravital-trust-bundles
S3_STATUS_LIST_BUCKET=gravital-status-lists
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# Puertos Expuestos de Servicios e Infraestructura
# ------------------------------------------------------------------------------
ANVIL_PORT=8545
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
INDEXER_PORT=8081
TRUST_SERVICE_PORT=8082
RELAY_PORT=8083
ISSUER_PORT=8084
