# --- Comandos del proyecto (detectados: Rust / cargo) ---
# KZ_TEST_CMD="cargo test --workspace"   # AGENTS.md §5.2 prefiere `cargo nextest run --workspace`; nextest no esta instalado en este entorno.
KZ_TEST_CMD="cargo test --workspace"
KZ_LINT_CMD="cargo clippy --workspace --all-targets --all-features -- -D warnings"
KZ_FMT_CMD="cargo fmt --all -- --check"

# Comando que imprime SOLO un numero: porcentaje de cobertura. Vacio = no se mide.
# cargo-llvm-cov esta disponible, pero no hay un comando unico y estable que imprima
# solo el porcentaje agregado del workspace sin recompilar: se deja vacio hasta
# definirlo explicitamente (no se inventa una metrica).
KZ_COVERAGE_CMD=""
# Comando que imprime SOLO un numero: cantidad de advertencias de lint. Vacio = no se mide.
KZ_WARNINGS_CMD=""

# --- Generales ---
KZ_DEFAULT_BRANCH="main"
KZ_DRAFTS_DIR="docs/kaizen/pr-drafts"
# Solo directorios de codigo fuente: `apps/` y `packages/` completos incluyen
# artefactos de build (.so, .apk, .dill) que inflan LOC y deuda erroneamente.
KZ_SRC_GLOBS="crates apps/reference-wallet/lib apps/reference-wallet/test bindings packages/gravital_experience_ui/lib packages/gravital_experience_ui/test xtask contracts/src contracts/test contracts/script"

# --- POLITICAS (1 = activa, 0 = desactivada). Aprobadas por el mantenedor 2026-11-21. ---
KZ_POLICY_COMMIT_MAX=256
KZ_POLICY_NO_EMOJI=1
KZ_POLICY_NO_AI_ATTRIBUTION=1
KZ_POLICY_BRANCH_PREFIXES_BLOCKED=""
